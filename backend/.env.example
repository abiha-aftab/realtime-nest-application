# All optional; defaults shown.
PORT=3000
# Comma-separated browser origins allowed besides the server's own host.
# "*" is refused on purpose. Example: http://localhost:5173
CORS_ORIGINS=
HISTORY_SIZE=100
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=10000
# 0 turns the built-in simulator off.
SIMULATOR_INTERVAL_MS=2000
# Folder with the built frontend; defaults to backend/public.
# STATIC_DIR=
